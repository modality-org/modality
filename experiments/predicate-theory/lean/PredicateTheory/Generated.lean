def case_J11_reg : Registry := registryWith [("/predicates/label_above.wasm", Declaration.ofText (some "(> $1 \"5\")") none)]
-- lint modality/declaration-unparsed: no
example : ((Declaration.ofText (some "(> $1 \"5\")") none).unparsed) = false := by decide

example : consistent case_J11_reg case_J11 = .unknown := by decide

/-! ### J10: Nonlinear declaration is outside V1 but inside a later fragment -/

def case_J10 : List Label := [⟨true, "wasm", ["/predicates/product_at_least.wasm", "/x.num", "/y.num", "100"], false⟩, ⟨true, "num_lt", ["/x.num", "1"], false⟩, ⟨true, "num_lt", ["/y.num", "1"], false⟩, ⟨true, "num_gt", ["/x.num", "0"], false⟩, ⟨true, "num_gt", ["/y.num", "0"], false⟩]
def case_J10_reg : Registry := registryWith [("/predicates/product_at_least.wasm", Declaration.ofText (some "(>= (* $1 $2) $3)") none)]
-- lint modality/declaration-unparsed: yes
example : ((Declaration.ofText (some "(>= (* $1 $2) $3)") none).unparsed) = true := by decide

example : consistent case_J10_reg case_J10 = .unknown := by decide

/-! ### K1: Two paths equal to one literal are equal -/

def case_K1 : List Label := [⟨true, "text_eq", ["/a.text", "x"], false⟩, ⟨true, "text_eq", ["/b.text", "x"], false⟩, ⟨false, "text_eq", ["/a.text", "/b.text"], false⟩]

theorem case_K1_dead :
    ∀ I, ¬ Sat I (expandAll standard case_K1).lits :=
  consistent_dead (by decide)

/-! ### K2: A key posted by literal is a member -/

def case_K2 : List Label := [⟨true, "text_eq", ["/m/a.id", "K"], false⟩, ⟨true, "all_signed", ["/m"], false⟩, ⟨false, "signed_by", ["/m/a.id"], false⟩]

theorem case_K2_dead :
    ∀ I, ¬ Sat I (expandAll standard case_K2).lits :=
  consistent_dead (by decide)

/-! ### K3: One key signs or does not, at every path that holds it -/

def case_K3 : List Label := [⟨true, "text_eq", ["/m/a.id", "K"], false⟩, ⟨true, "text_eq", ["/m/b.id", "K"], false⟩, ⟨true, "signed_by", ["/m/a.id"], false⟩, ⟨false, "signed_by", ["/m/b.id"], false⟩]

theorem case_K3_dead :
    ∀ I, ¬ Sat I (expandAll standard case_K3).lits :=
  consistent_dead (by decide)

/-! ### K4: Distinct signed keys count separately -/

def case_K4 : List Label := [⟨true, "text_eq", ["/m/a.id", "KA"], false⟩, ⟨true, "text_eq", ["/m/b.id", "KB"], false⟩, ⟨true, "signed_by", ["/m/a.id"], false⟩, ⟨true, "signed_by", ["/m/b.id"], false⟩, ⟨false, "threshold", ["2", "/m"], false⟩]

theorem case_K4_dead :
    ∀ I, ¬ Sat I (expandAll standard case_K4).lits :=
  consistent_dead (by decide)

/-! ### K5: The root prefix holds no keys -/

def case_K5 : List Label := [⟨true, "any_signed", ["/"], false⟩]

theorem case_K5_dead :
    ∀ I, ¬ Sat I (expandAll standard case_K5).lits :=
  consistent_dead (by decide)

/-! ### K6: A post is a POST -/

def case_K6 : List Label := [⟨true, "post_to_path", ["/x"], false⟩, ⟨false, "POST", [], true⟩]

theorem case_K6_dead :
    ∀ I, ¬ Sat I (expandAll standard case_K6).lits :=
  consistent_dead (by decide)

/-! ### K7: A non-empty sub-prefix of an all-signed prefix is all-signed -/

def case_K7 : List Label := [⟨true, "all_signed", ["/m"], false⟩, ⟨true, "any_signed", ["/m/a"], false⟩, ⟨false, "all_signed", ["/m/a"], false⟩]

theorem case_K7_dead :
    ∀ I, ¬ Sat I (expandAll standard case_K7).lits :=
  consistent_dead (by decide)

/-! ### K8: An all-signed prefix with an empty sub-prefix -/

def case_K8 : List Label := [⟨true, "all_signed", ["/m"], false⟩, ⟨false, "all_signed", ["/m/a"], false⟩]

theorem case_K8_live :
    (expandAll standard case_K8).exact = true ∧ ∀ I, Sat I (expandAll standard case_K8).lits :=
  consistent_live (by decide)

/-! ### K9: Static labels are decidable -/

def case_K9 : List Label := [⟨true, "APPROVE", [], true⟩, ⟨true, "modifies", ["/x"], false⟩, ⟨false, "POST", [], true⟩]

theorem case_K9_live :
    (expandAll standard case_K9).exact = true ∧ ∀ I, Sat I (expandAll standard case_K9).lits :=
  consistent_live (by decide)

/-! ### K10: A path cannot hold a number and a string -/

def case_K10 : List Label := [⟨true, "num_gt", ["/x.num", "0"], false⟩, ⟨true, "wasm", ["/predicates/named.wasm", "/x.num"], false⟩]
def case_K10_reg : Registry := registryWith [("/predicates/named.wasm", Declaration.ofText (some "(exists $1)") none)]
-- lint modality/declaration-unparsed: no
example : ((Declaration.ofText (some "(exists $1)") none).unparsed) = false := by decide

example : consistent case_K10_reg case_K10 = .unknown := by decide

/-! ### K11: Every posted key already signs -/

def case_K11 : List Label := [⟨true, "signed_by", ["/m/a.id"], false⟩, ⟨false, "all_signed", ["/m"], false⟩]

theorem case_K11_live :
    (expandAll standard case_K11).exact = true ∧ ∀ I, Sat I (expandAll standard case_K11).lits :=
  consistent_live (by decide)
theorem case_K11_runtime_dead :
    ∀ I, ¬ SatIn I (stateOf [("/m/a.id", "KA")]) (expandAll standard case_K11).lits :=
  runtime_dead (by decide)

/-! ### K12: Runtime: a threshold met by the posted keys -/

def case_K12 : List Label := [⟨true, "threshold", ["2", "/m"], false⟩]

theorem case_K12_live :
    (expandAll standard case_K12).exact = true ∧ ∀ I, Sat I (expandAll standard case_K12).lits :=
  consistent_live (by decide)
theorem case_K12_runtime_live :
    ∀ I, SatIn I (stateOf [("/m/a.id", "KA"), ("/m/b.id", "KB")]) (expandAll standard case_K12).lits :=
  runtime_live (by decide)

end PredicateTheory
