// RFC 8555 — ACME issuance governance formulas
// https://www.rfc-editor.org/rfc/rfc8555
//
// The model in ../model/default.modality is one satisfying witness.
// Citations below point to normative sections; see normative-core.md for the
// full extraction notes.
//
// Formulas use path-write predicates and authorization only (+sets, +signed_by).
// `sets(path, value)` is sugar for `post_to` / `posts_to` (same predicate). They
// must not name witness LTS nodes (opaque q0…q5).
//
// Order lifecycle: `/order/status.text` (RFC §7.1.6)
// Challenge lifecycle: `/challenge/status.text` (RFC §7.1.6, pending phase at q1)
//
// Order-state gates: when a status write is enabled, an earlier RFC status write
// must not still be enabled on the same step.

// RFC 8555 §7.4, §7.1.6 — https://www.rfc-editor.org/rfc/rfc8555#section-7.4
// §7.1.6: order is "ready" only when all authorizations are "valid".
// §7.4: finalize while not "ready" MUST fail ("orderNotReady").
formula finalize_requires_authorization {
  always(<+sets(/order/status.text, "processing")> true -> !<+sets(/order/status.text, "pending")> true)
}

// RFC 8555 §7.4 — https://www.rfc-editor.org/rfc/rfc8555#section-7.4
// "A request to finalize an order will result in error if the order is not in
//  the 'ready' state" (orderNotReady, 403 MUST).
formula finalize_requires_ready {
  always(<+sets(/order/status.text, "processing")> true -> !<+sets(/order/status.text, "ready")> true)
}

// RFC 8555 §7.4.2, §7.1.6 — https://www.rfc-editor.org/rfc/rfc8555#section-7.4.2
// §7.1.6: order enters "processing" after finalize, then "valid" with a
// "certificate" URL; issuance MUST NOT occur while order is still "ready".
formula issuance_requires_finalize {
  always(<+sets(/order/status.text, "valid")> true -> !<+sets(/order/status.text, "ready")> true)
}

// RFC 8555 §7.4.2, §6.2 — https://www.rfc-editor.org/rfc/rfc8555#section-7.4.2
// Server provisions the issued certificate URL on the order; issuance is a
// CA action (authenticated per §6.2), not the account holder.
formula only_ca_issues_certificate {
  always(<+sets(/order/status.text, "valid")> true -> <+signed_by(/users/certificate_authority.id)> true)
}

// RFC 8555 §7.1.6 — https://www.rfc-editor.org/rfc/rfc8555#section-7.1.6
// Order status is one field; "valid" and "invalid" are mutually exclusive outcomes
// (processing bifurcates to one or the other, not both on the same step).
formula valid_excludes_invalid {
  always(<+sets(/order/status.text, "valid")> true -> !<+sets(/order/status.text, "invalid")> true)
}

// RFC 8555 §7.1.6, §7.4 — https://www.rfc-editor.org/rfc/rfc8555#section-7.1.6
// Server/CA moves the order to "invalid" on issuance errors (including finalize
// responses with status "invalid"). Account holder does not set order "invalid".
formula only_ca_marks_order_invalid {
  always(<+sets(/order/status.text, "invalid")> true -> <+signed_by(/users/certificate_authority.id)> true)
}

// RFC 8555 §7.1.6, §7.5.1, §8.2 — https://www.rfc-editor.org/rfc/rfc8555#section-7.1.6
// §7.5.1: authorization requires a completed challenge response first.
// Order may become "ready" only after challenge leaves "pending".
formula authorization_requires_challenge {
  always(<+sets(/order/status.text, "ready")> true -> !<+sets(/challenge/status.text, "pending")> true)
}

// Governance formulas use `formula` blocks for model-checker corpus tests.
// When committing to a contract, wrap as `rule name { formula { ... } }`.

// RFC 8555 §7.6, §7.1.6 — https://www.rfc-editor.org/rfc/rfc8555#section-7.6
// revokeCert (§7.6) revokes the certificate; issuance failure sets order
// "invalid" (§7.1.6). Both forbid operational certificate use in this slice.
formula revocation_blocks_use {
  always(
    (<+sets(/order/status.text, "invalid")> true | <+sets(/certificate/revoked.text, "true")> true)
    -> always([-sets(/certificate/in_use.text, "true")] true)
  )
}

// RFC 8555 §7.1.4 — https://www.rfc-editor.org/rfc/rfc8555#section-7.1.4
// "The client begins the certificate issuance process by sending a POST
//  request to the server's newOrder resource" (signed by the account key, §6.2).
formula only_holder_creates_order {
  always(<+sets(/order/status.text, "pending")> true -> <+signed_by(/users/account_holder.id)> true)
}

// RFC 8555 §7.4 — https://www.rfc-editor.org/rfc/rfc8555#section-7.4
// "Once the client believes it has fulfilled the server's requirements, it
//  should send a POST request to the order resource's finalize URL" (account key).
formula only_holder_finalizes {
  always(<+sets(/order/status.text, "processing")> true -> <+signed_by(/users/account_holder.id)> true)
}

// RFC 8555 §7.4, §7.1.4 — https://www.rfc-editor.org/rfc/rfc8555#section-7.4
// newOrder (§7.4) creates the order object (§7.1.3) before finalize is possible;
// challenge workflow must have started before order enters "processing".
formula finalize_requires_order {
  always(<+sets(/order/status.text, "processing")> true -> !<+sets(/challenge/status.text, "pending")> true)
}

// RFC 8555 §7.5.1, §7.1.6 — https://www.rfc-editor.org/rfc/rfc8555#section-7.5.1
// Setting challenge status to "valid" (authorization finalized) is a CA/server action.
// Client completion sets "processing" (§7.1.6) and is covered by model `signed_by` on edges.
formula only_ca_validates_authorization {
  always(<+sets(/challenge/status.text, "valid")> true -> <+signed_by(/users/certificate_authority.id)> true)
}

// RFC 8555 §7.1.6 — https://www.rfc-editor.org/rfc/rfc8555#section-7.1.6
// `[-sets(path, v)] false` means the path value must be `v`; OR adds allowed options.
formula order_status_values {
  always(
    [-sets(/order/status.text, "pending")] false |
    [-sets(/order/status.text, "ready")] false |
    [-sets(/order/status.text, "processing")] false |
    [-sets(/order/status.text, "valid")] false |
    [-sets(/order/status.text, "invalid")] false
  )
}

// RFC 8555 §7.1.6 — challenge status enum on `/challenge/status.text`.
formula challenge_status_values {
  always(
    [-sets(/challenge/status.text, "pending")] false |
    [-sets(/challenge/status.text, "processing")] false |
    [-sets(/challenge/status.text, "valid")] false
  )
}
