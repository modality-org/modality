// Formula Syntax Examples
// Demonstrates all formula operators in the new Modality syntax

// ============================================================
// MODAL OPERATORS
// ============================================================

// Diamond: "there exists a transition"
formula DiamondExample {
  // Some +PAY transition to true
  <+PAY> true
}

// Box: "all transitions lead to"
formula BoxExample {
  // All +EXECUTE transitions lead to complete
  [+EXECUTE] complete
}

// Unlabeled modal operators
formula UnlabeledBox {
  // All transitions lead to safe
  [] safe
}

formula UnlabeledDiamond {
  // Some transition leads to goal
  <> goal
}

// Diamondbox: "committed" (can do AND cannot refuse)
// [<+A>] φ  ≡  [-A] false & <+A> φ
formula Committed {
  [<+signed_by(/users/alice.id)>] true
}

formula CommittedOr {
  [<+signed_by(/users/alice.id)>] true | [<+signed_by(/users/bob.id)>] true
}

// ============================================================
// TEMPORAL OPERATORS
// ============================================================

// Always: holds at every state on all paths
formula AlwaysExample {
  always(safe)
}

// Eventually: holds at some future state
formula EventuallyExample {
  eventually(goal)
}

// Next: holds in the next state
formula NextExample {
  next(ready)
}

// Until: p holds until q becomes true
formula UntilExample {
  waiting until done
}

// Combined temporal
formula AlwaysEventually {
  // Infinitely often reach checkpoint
  always(eventually(checkpoint))
}

// ============================================================
// FIXED POINTS (Modal Mu-Calculus)
// ============================================================

// Least fixed point (lfp): reachability properties
// lfp(X, φ) = smallest set satisfying X = φ[X]
formula LfpReachability {
  // Can reach goal (= eventually(goal))
  lfp(X, goal | <>X)
}

// Greatest fixed point (gfp): invariant properties
// gfp(X, φ) = largest set satisfying X = φ[X]
formula GfpInvariant {
  // Always safe (= always(safe))
  gfp(X, safe & []X)
}

// Nested fixed points
formula InfinitelyOften {
  gfp(Y, lfp(X, checkpoint | <>X) & []Y)
}

// Unicode notation (μ = lfp, ν = gfp)
formula MuNotation {
  μX.(goal | <>X)
}

formula NuNotation {
  νX.(safe & []X)
}

// ============================================================
// BOOLEAN OPERATORS
// ============================================================

formula Conjunction {
  // AND with &
  safe & ready
}

formula ConjunctionWord {
  // AND with keyword
  safe and ready
}

formula Disjunction {
  // OR with |
  error | warning
}

formula DisjunctionWord {
  // OR with keyword
  error or warning
}

formula Negation {
  // NOT with !
  !error
}

formula NegationWord {
  // NOT with keyword
  not error
}

formula Conditional {
  // Conditional rule in explicit Boolean form
  !request | response
}

// ============================================================
// COMBINED EXAMPLES
// ============================================================

// Escrow safety: release requires delivery evidence on the same move
formula EscrowSafety {
  always([+RELEASE -delivered] false)
}

// Multi-sig requirement: execute requires both signatures
formula MultiSig {
  always(
    ([+EXECUTE -signed_by(/users/alice.id)] false)
    & ([+EXECUTE -signed_by(/users/bob.id)] false)
  )
}

// Authorization rule: every commit is signed by Alice or Bob
formula AuthorizationRequired {
  always([-signed_by(/users/alice.id) -signed_by(/users/bob.id)] false)
}

// Liveness: from any state, a COMPLETE move stays reachable
formula Liveness {
  always(eventually(<+COMPLETE> true))
}
