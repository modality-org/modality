// Agent Task Exchange
//
// Two agents cooperate: one requests a task, the other does it. Neither
// trusts the other. The rules make the exchange fair: no payment without
// submitted work, no refund without a dispute, and nothing after the task
// closes.
//
// Requester: wants work done, has payment
// Executor: can do work, wants payment
//
// Each step posts a flag under /task: CLAIM posts claimed.bool,
// SUBMIT_RESULT submitted.bool, REJECT disputed.bool, and the step that ends
// the task (ACCEPT, RELEASE, REFUND, EXPIRE) posts closed.bool.
//
// The actions (+POST_TASK, +CLAIM, +SUBMIT_RESULT, +ACCEPT, +REJECT, +RELEASE, +REFUND, +EXPIRE) are named by this contract. Labels are open: an edge
// could be taken by a commit that also carries another action, or another
// party's signature, unless the edge rules it out. So each edge says which
// actions it is not, and which restricted signers it does not carry. The
// nodes are witness nodes, not phases: the phase lives in posted state
// flags, which the rules read.

model TaskExchange {
  part flow {
    q0 --> q1: +POST_TASK +signed_by(/parties/requester.id) -signed_by(/parties/arbiter.id) -bool_true(/task/closed.bool) -CLAIM -SUBMIT_RESULT -ACCEPT -REJECT -RELEASE -REFUND -EXPIRE
    q1 --> q2: +CLAIM +signed_by(/parties/executor.id) -bool_true(/task/claimed.bool) -signed_by(/parties/arbiter.id) -bool_true(/task/closed.bool) -POST_TASK -SUBMIT_RESULT -ACCEPT -REJECT -RELEASE -REFUND -EXPIRE
    q1 --> q5: +EXPIRE -bool_true(/task/claimed.bool) -signed_by(/parties/arbiter.id) -bool_true(/task/closed.bool) -POST_TASK -CLAIM -SUBMIT_RESULT -ACCEPT -REJECT -RELEASE -REFUND
    q2 --> q3: +SUBMIT_RESULT +signed_by(/parties/executor.id) +bool_true(/task/claimed.bool) -signed_by(/parties/arbiter.id) -bool_true(/task/closed.bool) -POST_TASK -CLAIM -ACCEPT -REJECT -RELEASE -REFUND -EXPIRE
    q3 --> q5: +ACCEPT +signed_by(/parties/requester.id) +bool_true(/task/submitted.bool) -signed_by(/parties/arbiter.id) -bool_true(/task/closed.bool) -POST_TASK -CLAIM -SUBMIT_RESULT -REJECT -RELEASE -REFUND -EXPIRE
    q3 --> q4: +REJECT +signed_by(/parties/requester.id) +bool_true(/task/submitted.bool) -signed_by(/parties/arbiter.id) -bool_true(/task/closed.bool) -POST_TASK -CLAIM -SUBMIT_RESULT -ACCEPT -RELEASE -REFUND -EXPIRE
    q4 --> q5: +RELEASE +signed_by(/parties/arbiter.id) +bool_true(/task/disputed.bool) -bool_true(/task/closed.bool) -POST_TASK -CLAIM -SUBMIT_RESULT -ACCEPT -REJECT -REFUND -EXPIRE
    q4 --> q5: +REFUND +signed_by(/parties/arbiter.id) +bool_true(/task/disputed.bool) -bool_true(/task/closed.bool) -POST_TASK -CLAIM -SUBMIT_RESULT -ACCEPT -REJECT -RELEASE -EXPIRE
  }
}

// ============================================================
// RULES AN AGENT CAN CHECK BEFORE PARTICIPATING
// ============================================================

// For the executor: only the requester posts, accepts or rejects; only the
// executor claims and submits.
formula PartiesSignTheirSteps {
  always(([+POST_TASK -signed_by(/parties/requester.id)] false) & ([+ACCEPT -signed_by(/parties/requester.id)] false) & ([+REJECT -signed_by(/parties/requester.id)] false) & ([+CLAIM -signed_by(/parties/executor.id)] false) & ([+SUBMIT_RESULT -signed_by(/parties/executor.id)] false))
}

// For the requester: payment only for submitted work.
formula PaymentRequiresWork {
  always([+ACCEPT -bool_true(/task/submitted.bool)] false)
}

// For the executor: a claimed task cannot expire under them.
formula NoExpiryAfterClaim {
  always([+EXPIRE +bool_true(/task/claimed.bool)] false)
}

// A refund, and an arbiter's release, only settle a dispute.
formula RefundOnlyViaDispute {
  always(([+REFUND -bool_true(/task/disputed.bool)] false) & ([+RELEASE -bool_true(/task/disputed.bool)] false))
}

// The arbiter signs nothing outside a dispute.
formula ArbiterOnlyOnDispute {
  always([+signed_by(/parties/arbiter.id) -bool_true(/task/disputed.bool)] false)
}

// Nothing happens after the task closes, so it is paid or refunded once.
formula NoDoublePay {
  always([+bool_true(/task/closed.bool)] false)
}

// ============================================================
// HOW AGENTS USE THIS
// ============================================================
//
// Before participating, each agent checks the rules that protect it
// against this model:
//
//   modal model check agent_task_exchange.modality -f PaymentRequiresWork
//   modal model check agent_task_exchange.modality -f NoExpiryAfterClaim
//
// and, once the contract exists, that its accepted rules include them:
// rules only accumulate, so no later model can drop one.
//
//   Requester                          Executor
//   ---------                          --------
//   1. Check the rules
//   2. POST_TASK (sign)
//                                      3. Check the rules
//                                      4. CLAIM (sign)
//                                      5. Do the work
//                                      6. SUBMIT_RESULT (sign)
//   7. Review the result
//   8. ACCEPT (sign): payment released
//                                      9. Receive payment
//
// Neither agent trusted the other. The rules enforced the exchange.
