// Milestone-Based Project: multi-phase work with staged payments
//
// A common pattern for development contracts and freelance work. Each step
// posts a flag under /project (started, design_done, design_paid,
// build_done, build_paid, test_done, test_paid), and the rules read them.
//
// The actions (+START, +COMPLETE_DESIGN, +PAY_DESIGN, +COMPLETE_BUILD, +PAY_BUILD, +COMPLETE_TEST, +PAY_TEST, +FINALIZE) are named by this contract.
// Labels are open: an edge could be taken by a commit that also carries
// another action, or another party's signature, unless the edge rules it
// out. So each edge says which actions it is not, and which restricted
// signers it does not carry. The nodes are witness nodes, not phases: the
// phase lives in posted state flags, which the rules read.

model MilestoneProject {
  part project {
    q0 --> q1: +START +signed_by(/parties/client.id) -signed_by(/parties/contractor.id) -COMPLETE_DESIGN -PAY_DESIGN -COMPLETE_BUILD -PAY_BUILD -COMPLETE_TEST -PAY_TEST -FINALIZE
    q1 --> q2: +COMPLETE_DESIGN +signed_by(/parties/contractor.id) +bool_true(/project/started.bool) -signed_by(/parties/client.id) -START -PAY_DESIGN -COMPLETE_BUILD -PAY_BUILD -COMPLETE_TEST -PAY_TEST -FINALIZE
    q2 --> q3: +PAY_DESIGN +signed_by(/parties/client.id) +bool_true(/project/design_done.bool) -signed_by(/parties/contractor.id) -START -COMPLETE_DESIGN -COMPLETE_BUILD -PAY_BUILD -COMPLETE_TEST -PAY_TEST -FINALIZE
    q3 --> q4: +COMPLETE_BUILD +signed_by(/parties/contractor.id) +bool_true(/project/design_paid.bool) -signed_by(/parties/client.id) -START -COMPLETE_DESIGN -PAY_DESIGN -PAY_BUILD -COMPLETE_TEST -PAY_TEST -FINALIZE
    q4 --> q5: +PAY_BUILD +signed_by(/parties/client.id) +bool_true(/project/build_done.bool) -signed_by(/parties/contractor.id) -START -COMPLETE_DESIGN -PAY_DESIGN -COMPLETE_BUILD -COMPLETE_TEST -PAY_TEST -FINALIZE
    q5 --> q6: +COMPLETE_TEST +signed_by(/parties/contractor.id) +bool_true(/project/build_paid.bool) -signed_by(/parties/client.id) -START -COMPLETE_DESIGN -PAY_DESIGN -COMPLETE_BUILD -PAY_BUILD -PAY_TEST -FINALIZE
    q6 --> q7: +PAY_TEST +signed_by(/parties/client.id) +bool_true(/project/test_done.bool) -signed_by(/parties/contractor.id) -START -COMPLETE_DESIGN -PAY_DESIGN -COMPLETE_BUILD -PAY_BUILD -COMPLETE_TEST -FINALIZE
    q7 --> q8: +FINALIZE +signed_by(/parties/client.id) +bool_true(/project/test_paid.bool) -signed_by(/parties/contractor.id) -START -COMPLETE_DESIGN -PAY_DESIGN -COMPLETE_BUILD -PAY_BUILD -COMPLETE_TEST -PAY_TEST
  }
}

// No payment without the completed milestone.
formula PayOnlyForCompleted {
  always(([+PAY_DESIGN -bool_true(/project/design_done.bool)] false) & ([+PAY_BUILD -bool_true(/project/build_done.bool)] false) & ([+PAY_TEST -bool_true(/project/test_done.bool)] false))
}

// Phases are sequential: each starts after the previous one is paid.
formula SequentialPhases {
  always(([+COMPLETE_BUILD -bool_true(/project/design_paid.bool)] false) & ([+COMPLETE_TEST -bool_true(/project/build_paid.bool)] false))
}

// Only the contractor completes work.
formula ContractorCompletesWork {
  always(([+COMPLETE_DESIGN -signed_by(/parties/contractor.id)] false) & ([+COMPLETE_BUILD -signed_by(/parties/contractor.id)] false) & ([+COMPLETE_TEST -signed_by(/parties/contractor.id)] false))
}

// Only the client pays.
formula ClientPays {
  always(([+PAY_DESIGN -signed_by(/parties/client.id)] false) & ([+PAY_BUILD -signed_by(/parties/client.id)] false) & ([+PAY_TEST -signed_by(/parties/client.id)] false))
}
