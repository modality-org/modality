// Bank Deposits Contract
//
// A multi-account bank on one contract. Each account's balance is tracked at
// /bank/accounts/<account_id>.json. The admin registers accounts and can
// pause the bank; PAUSE posts /bank/paused.bool true and RESUME false.
//
// WITHDRAW is checked by the contract hub, not by these rules: it verifies
// that the account's owner signed and that the balance covers the amount.
// See examples/hub-scenarios/bank-deposits.md.
//
// The actions (+REGISTER_ACCOUNT, +DEPOSIT, +WITHDRAW, +PAUSE, +RESUME) are named by this contract.
// Labels are open: an edge could be taken by a commit that also carries
// another action, or another party's signature, unless the edge rules it
// out. So each edge says which actions it is not, and which restricted
// signers it does not carry. The nodes are witness nodes, not phases: the
// phase lives in posted state flags, which the rules read.

model bank {
  part flow {
    q0 --> q0: +REGISTER_ACCOUNT +signed_by(/bank/admin.id) -bool_true(/bank/paused.bool) -DEPOSIT -WITHDRAW -PAUSE -RESUME
    q0 --> q0: +DEPOSIT -bool_true(/bank/paused.bool) -REGISTER_ACCOUNT -WITHDRAW -PAUSE -RESUME
    q0 --> q0: +WITHDRAW -bool_true(/bank/paused.bool) -REGISTER_ACCOUNT -DEPOSIT -PAUSE -RESUME
    q0 --> q1: +PAUSE +signed_by(/bank/admin.id) -bool_true(/bank/paused.bool) -REGISTER_ACCOUNT -DEPOSIT -WITHDRAW -RESUME
    q1 --> q0: +RESUME +signed_by(/bank/admin.id) +bool_true(/bank/paused.bool) -REGISTER_ACCOUNT -DEPOSIT -WITHDRAW -PAUSE
  }
}

// Only the admin registers accounts, pauses and resumes.
formula AdminControls {
  always(([+REGISTER_ACCOUNT -signed_by(/bank/admin.id)] false) & ([+PAUSE -signed_by(/bank/admin.id)] false) & ([+RESUME -signed_by(/bank/admin.id)] false))
}

// While paused, the only move is the admin's RESUME.
formula PausedMeansPaused {
  always([+bool_true(/bank/paused.bool) -RESUME] false)
}
