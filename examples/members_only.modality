// Members-Only Contract
//
// Only members can commit. Changing the membership takes the signature of
// every current member.
//
// State:
//   /members/alice.id   alice's Modality ID
//   /members/bob.id     bob's Modality ID
//
// The model is the witness a rule commit needs: each formula below holds
// from the node the bootstrap commit reaches (q1). Nodes are witness nodes,
// not contract phases.

model members_only {
  part flow {
    // The bootstrap commit: the first member, this model and the rules
    q0 --> q1
    // A member writes outside /members
    q1 --> q1: +any_signed(/members) -modifies(/members)
    // A membership change carries every current member's signature
    q1 --> q1: +any_signed(/members) +all_signed(/members)
  }
}

// Every commit after the rules are added is signed by a member.
// +any_signed(/members) reads the .id files under /members in accepted state.
formula member_required {
  always([-any_signed(/members)] false)
}

// A commit that changes /members is signed by every current member.
// all_signed(/members) is read from accepted state, so it grows as members
// are added: alice alone, then alice and bob, then all three.
formula membership_change_unanimous {
  always([+modifies(/members) -all_signed(/members)] false)
}

// ============================================================
// WORKFLOW (modal CLI)
// ============================================================
//
// 1. Create the contract and alice's identity:
//    modal id create --name alice
//    modal contract create
//    modal c checkout
//    modal c set-named-id /members/alice.id alice
//
// 2. Write the model above to model/default.modality, add the rules, and
//    commit all of it signed by alice:
//    modal add-rule --name member_required 'always([-any_signed(/members)] false)'
//    modal add-rule --name membership_unanimous 'always([+modifies(/members) -all_signed(/members)] false)'
//    modal c commit --all --sign alice -m "Bootstrap members-only contract"
//
// 3. Alice adds Bob. She is the only member, so her signature is all of them:
//    modal id create --name bob
//    modal c set-named-id /members/bob.id bob
//    modal c commit --all --sign alice -m "Add Bob"
//
// 4. Adding Carol now takes both alice and bob:
//    modal id create --name carol
//    modal c set-named-id /members/carol.id carol
//    modal c commit --all --sign alice --sign bob -m "Add Carol"
//
// 5. Any member may write outside /members:
//    modal c commit --path /data/notes.md --value "# Meeting notes" --sign bob
//
// 6. A commit signed by a non-member is refused: +any_signed(/members) is
//    false for it.
