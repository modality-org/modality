        {
          "method": "rule",
          "path": "/rules/either_party.modality",
          "value": "export default rule {\n  starting_at $PARENT\n  formula {\n    always([-signed_by(/parties/alice.id) -signed_by(/parties/bob.id)] false)\n  }\n}\n"
        },
        {
          "method": "rule",
          "path": "/rules/parties_fixed.modality",
          "value": "export default rule {\n  starting_at $PARENT\n  formula {\n    always([+modifies(/parties)] false)\n  }\n}\n"
        },
        {
          "method": "model",
          "path": "/model/default.modality",
          "value": "model exchange {\n  part flow {\n    q0 --> q1\n    q1 --> q1: +signed_by(/parties/alice.id) -modifies(/parties)\n    q1 --> q1: +signed_by(/parties/bob.id) -modifies(/parties)\n  }\n}\n"
        }
      ],
