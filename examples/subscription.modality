// Subscription: recurring access with periodic payments
//
// Useful for API access, service agreements and memberships. SUBSCRIBE,
// RENEW and RESUBSCRIBE carry a +PAY and post /subscription/active.bool
// true; EXPIRE and CANCEL post it false.
//
// EXPIRE is unsigned: a keeper posts it when the period ends. Time
// predicates (`after`) are not evaluated yet, so no rule ties it to a date.
//
// The actions (+SUBSCRIBE, +ACCESS, +RENEW, +EXPIRE, +CANCEL, +RESUBSCRIBE) are named by this contract.
// Labels are open: an edge could be taken by a commit that also carries
// another action, or another party's signature, unless the edge rules it
// out. So each edge says which actions it is not, and which restricted
// signers it does not carry. The nodes are witness nodes, not phases: the
// phase lives in posted state flags, which the rules read.

model Subscription {
  part access {
    q0 --> q1: +SUBSCRIBE +PAY +signed_by(/parties/subscriber.id) -ACCESS -RENEW -EXPIRE -CANCEL -RESUBSCRIBE
    q1 --> q1: +ACCESS +signed_by(/parties/subscriber.id) +bool_true(/subscription/active.bool) -PAY -SUBSCRIBE -RENEW -EXPIRE -CANCEL -RESUBSCRIBE
    q1 --> q1: +RENEW +PAY +signed_by(/parties/subscriber.id) +bool_true(/subscription/active.bool) -SUBSCRIBE -ACCESS -EXPIRE -CANCEL -RESUBSCRIBE
    q1 --> q2: +EXPIRE +bool_true(/subscription/active.bool) -PAY -signed_by(/parties/subscriber.id) -SUBSCRIBE -ACCESS -RENEW -CANCEL -RESUBSCRIBE
    q1 --> q2: +CANCEL +signed_by(/parties/subscriber.id) +bool_true(/subscription/active.bool) -PAY -SUBSCRIBE -ACCESS -RENEW -EXPIRE -RESUBSCRIBE
    q2 --> q1: +RESUBSCRIBE +PAY +signed_by(/parties/subscriber.id) -bool_true(/subscription/active.bool) -SUBSCRIBE -ACCESS -RENEW -EXPIRE -CANCEL
  }
}

// No access without an active subscription.
formula NoAccessWithoutSubscription {
  always([+ACCESS -bool_true(/subscription/active.bool)] false)
}

// Every subscription, renewal and resubscription is paid.
formula PaymentRequired {
  always(([+SUBSCRIBE -PAY] false) & ([+RENEW -PAY] false) & ([+RESUBSCRIBE -PAY] false))
}

// Only the subscriber cancels.
formula OnlySubscriberCancels {
  always([+CANCEL -signed_by(/parties/subscriber.id)] false)
}
