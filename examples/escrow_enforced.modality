// Escrow Contract with Enforcing Rules
//
// The rules are the specification; the model is one witness that meets
// them. Any model that meets them is as safe.
//
// DEPOSIT posts /escrow/deposited.bool, DELIVER delivered.bool, DISPUTE
// disputed.bool, and RELEASE or REFUND posts closed.bool. Each rule forbids
// the commits that lack the evidence: `[+ACTION -evidence] false`.
//
// The actions (+DEPOSIT, +DELIVER, +RELEASE, +DISPUTE, +REFUND) are named by this contract.
// Labels are open: an edge could be taken by a commit that also carries
// another action, or another party's signature, unless the edge rules it
// out. So each edge says which actions it is not, and which restricted
// signers it does not carry. The nodes are witness nodes, not phases: the
// phase lives in posted state flags, which the rules read.

model Escrow {
  part flow {
    q0 --> q1: +DEPOSIT +signed_by(/parties/buyer.id) -bool_true(/escrow/deposited.bool) -signed_by(/parties/arbiter.id) -bool_true(/escrow/closed.bool) -DELIVER -RELEASE -DISPUTE -REFUND
    q1 --> q2: +DELIVER +signed_by(/parties/seller.id) +bool_true(/escrow/deposited.bool) -signed_by(/parties/arbiter.id) -bool_true(/escrow/closed.bool) -DEPOSIT -RELEASE -DISPUTE -REFUND
    q2 --> q4: +RELEASE +signed_by(/parties/buyer.id) +bool_true(/escrow/delivered.bool) -signed_by(/parties/arbiter.id) -bool_true(/escrow/closed.bool) -DEPOSIT -DELIVER -DISPUTE -REFUND
    q2 --> q3: +DISPUTE +signed_by(/parties/buyer.id) +bool_true(/escrow/delivered.bool) -signed_by(/parties/arbiter.id) -bool_true(/escrow/closed.bool) -DEPOSIT -DELIVER -RELEASE -REFUND
    q3 --> q4: +REFUND +signed_by(/parties/arbiter.id) +bool_true(/escrow/disputed.bool) -bool_true(/escrow/closed.bool) -DEPOSIT -DELIVER -RELEASE -DISPUTE
    q3 --> q4: +RELEASE +signed_by(/parties/arbiter.id) +bool_true(/escrow/disputed.bool) -bool_true(/escrow/closed.bool) -DEPOSIT -DELIVER -DISPUTE -REFUND
  }
}

// 1. Each party signs its own steps.
formula PartiesSignTheirSteps {
  always(([+DEPOSIT -signed_by(/parties/buyer.id)] false) & ([+DELIVER -signed_by(/parties/seller.id)] false) & ([+DISPUTE -signed_by(/parties/buyer.id)] false))
}

// 2. Delivery follows a deposit.
formula DeliveryAfterDeposit {
  always([+DELIVER -bool_true(/escrow/deposited.bool)] false)
}

// 3. Funds are released by the buyer after delivery, or by the arbiter in a
//    dispute.
formula ReleaseConditions {
  always(([+RELEASE -bool_true(/escrow/delivered.bool) -bool_true(/escrow/disputed.bool)] false) & ([+RELEASE -signed_by(/parties/buyer.id) -signed_by(/parties/arbiter.id)] false))
}

// 4. A dispute follows delivery, and only the arbiter refunds, in a dispute.
formula DisputeAndRefund {
  always(([+DISPUTE -bool_true(/escrow/delivered.bool)] false) & ([+REFUND -signed_by(/parties/arbiter.id)] false) & ([+REFUND -bool_true(/escrow/disputed.bool)] false))
}

// 5. The arbiter signs nothing outside a dispute.
formula ArbiterOnlyOnDispute {
  always([+signed_by(/parties/arbiter.id) -bool_true(/escrow/disputed.bool)] false)
}

// 6. No double spend: nothing happens after a release or refund closes it.
formula NoDoubleSpend {
  always([+bool_true(/escrow/closed.bool)] false)
}
