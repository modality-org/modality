// Delegation: a principal grants an agent authority to act on its behalf
//
// Useful for AI agents that delegate tasks. DELEGATE posts
// /delegation/granted.bool true; REVOKE posts /delegation/revoked.bool true.
// The agent acts only between the two.
//
// The actions (+DELEGATE, +ACT_ON_BEHALF, +REVOKE) are named by this contract.
// Labels are open: an edge could be taken by a commit that also carries
// another action, or another party's signature, unless the edge rules it
// out. So each edge says which actions it is not, and which restricted
// signers it does not carry. The nodes are witness nodes, not phases: the
// phase lives in posted state flags, which the rules read.

model Delegation {
  part authority {
    q0 --> q1: +DELEGATE +signed_by(/parties/principal.id) -bool_true(/delegation/revoked.bool) -signed_by(/parties/agent.id) -ACT_ON_BEHALF -REVOKE
    q1 --> q1: +ACT_ON_BEHALF +signed_by(/parties/agent.id) +bool_true(/delegation/granted.bool) -bool_true(/delegation/revoked.bool) -signed_by(/parties/principal.id) -DELEGATE -REVOKE
    q1 --> q2: +REVOKE +signed_by(/parties/principal.id) +bool_true(/delegation/granted.bool) -signed_by(/parties/agent.id) -DELEGATE -ACT_ON_BEHALF
  }
}

// Only the agent acts on the principal's behalf.
formula OnlyAgentCanAct {
  always([+ACT_ON_BEHALF -signed_by(/parties/agent.id)] false)
}

// The agent acts only after a delegation, and never after a revocation.
formula ActsOnlyWhileDelegated {
  always(([+ACT_ON_BEHALF -bool_true(/delegation/granted.bool)] false) & ([+ACT_ON_BEHALF +bool_true(/delegation/revoked.bool)] false))
}

// Only the principal delegates or revokes.
formula PrincipalControlsAuthority {
  always(([+DELEGATE -signed_by(/parties/principal.id)] false) & ([+REVOKE -signed_by(/parties/principal.id)] false))
}

// Flow: the principal delegates; the agent acts any number of times; the
// principal revokes, after which an ACT_ON_BEHALF commit is refused.
