// Trustless Escrow Contract
//
// Two parties (buyer/seller) execute a deal with guaranteed protection.
// Neither can cheat — all actions are signed and verified.

model Escrow {
  initial init
  
  // Buyer deposits funds
  init -> deposited [+modifies(/escrow/deposited) +signed_by(/parties/buyer.id) -modifies(/escrow/delivered) -modifies(/escrow/released)]
  
  // Seller delivers goods/data
  deposited -> delivered [+modifies(/escrow/delivered) +signed_by(/parties/seller.id) -modifies(/escrow/deposited) -modifies(/escrow/released)]
  
  // Buyer releases payment (happy path)
  delivered -> released [+modifies(/escrow/released) +signed_by(/parties/buyer.id) -modifies(/escrow/deposited) -modifies(/escrow/delivered)]
  
  // Terminal state: nothing in the escrow changes
  released -> released [-modifies(/escrow/deposited) -modifies(/escrow/delivered) -modifies(/escrow/released)]
}

// Protection rules — these can NEVER be bypassed. Each refuses every commit
// that changes a part of the escrow without the named party's signature.

formula buyer_must_sign_deposit {
  always([+modifies(/escrow/deposited) -signed_by(/parties/buyer.id)] false)
}

formula seller_must_sign_delivery {
  always([+modifies(/escrow/delivered) -signed_by(/parties/seller.id)] false)
}

formula buyer_must_sign_release {
  always([+modifies(/escrow/released) -signed_by(/parties/buyer.id)] false)
}
