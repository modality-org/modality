// Protection Rings Contract — Two Repo Architecture
//
// kernel-repo: DB schema, auth, config, deploy scripts, secrets
//   - Only Kernel Agent can commit
//   - Requires human co-signature for all changes
//   - App Agent has ZERO access (can't read or write)
//
// app-repo: routes, components, tests, docs
//   - App Agent commits freely
//   - No approval needed
//
// The two agents cooperate through a shared contract,
// not through shared code.

model protection_rings {
  initial active

  // Labels are open: an edge could be taken by a commit that also writes
  // the other repo, or carries another signature, unless it says otherwise.

  // App agent commits freely to app-repo, and only there
  active -> active [+signed_by(/agents/app.id) +modifies(/app_repo) -modifies(/kernel_repo)]

  // Kernel agent commits to kernel-repo with human approval
  active -> active [+signed_by(/agents/kernel.id) +signed_by(/humans/admin.id) +modifies(/kernel_repo) -signed_by(/agents/app.id)]

  // Kernel agent can also commit to app-repo (e.g. exposing new APIs)
  active -> active [+signed_by(/agents/kernel.id) +signed_by(/humans/admin.id) +modifies(/app_repo) -modifies(/kernel_repo) -signed_by(/agents/app.id)]
}

// === RULES ===

// Rule 1: App agent CANNOT touch kernel-repo — can't read, can't write.
// The repo boundary enforces read isolation.
// The contract enforces write isolation.
formula app_cannot_touch_kernel {
  always([+signed_by(/agents/app.id) +modifies(/kernel_repo)] false)
}

// Rule 2: ALL kernel-repo changes require the kernel agent and the human.
formula kernel_requires_dual_signature {
  always(([+modifies(/kernel_repo) -signed_by(/agents/kernel.id)] false) & ([+modifies(/kernel_repo) -signed_by(/humans/admin.id)] false))
}

// Rule 3: Only known identities can commit.
formula known_signers_only {
  always([-signed_by(/agents/app.id) -signed_by(/agents/kernel.id) -signed_by(/humans/admin.id)] false)
}
