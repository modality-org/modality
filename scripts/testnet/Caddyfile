# Observer / public explorer host (Lightsail testnet0).
# Primary names live on modality.network. modal.money names redirect.
# Join instructions stay on the apex; contract explorer is node0.

testnet.modality.network {
	encode gzip
	handle /status.json {
		reverse_proxy 127.0.0.1:1337
	}
	handle {
		root * /var/www/html
		file_server
	}
}

node0.testnet.modality.network {
	reverse_proxy 127.0.0.1:1337
}

testnet.modal.money {
	redir https://testnet.modality.network{uri} permanent
}

node0.testnet.modal.money {
	redir https://node0.testnet.modality.network{uri} permanent
}
