// A part with a single node and a transition back to itself
model InitialModel {
  part p1 {
    n1 --> n1
  }
}

// A part with an acyclic set of three nodes, +blue on each transition
model Model1 {
  part p1 {
    n1 --> n2: +blue
    n2 --> n3: +blue
  }
}

// A part with a cycle of three nodes, +blue on each transition
model Model3 {
  part p1 {
    n1 --> n2: +blue
    n2 --> n3: +blue
    n3 --> n1: +blue
  }
}

// A part with a cycle of three nodes
model Model4 {
  part p1 {
    n1 --> n2: +blue -red
    n2 --> n3: +blue -green
    n3 --> n1: -blue +red
  }
}

// A model with two parts
model Model5 {
  part p1 {
    n1 --> n2: +blue -red
    n2 --> n3: +blue -green
    n3 --> n1: -blue +red
  }
  part p2 {
    n1 --> n1: +yellow
  }
}

// Model5, starting at n1. A model file names its start node with `initial`;
// which nodes a contract is at is kept by the contract, not the model.
model Model6 {
  initial n1
  part p1 {
    n1 --> n2: +blue -red
    n2 --> n3: +blue -green
    n3 --> n1: -blue +red
  }
  part p2 {
    n1 --> n1: +yellow
  }
}

// Boolean formulas
formula FormulaTrue {
  true
}

formula FormulaFalse {
  false
}

formula FormulaBooleanWff {
  (true or false) and true
}

// True within Model1
formula FormulaDiamondBlueTrue {
  <+blue> true
}

formula FormulaBoxNegBlueFalse {
  [-blue] false
}

formula FormulaBoxNegBlueTrue {
  <+blue> <+blue> [-blue] false
}

// False within Model6: +yellow is not on the +blue transition
formula FormulaBlueNotYellow {
  <+blue -yellow> true
}

// True within Model6: parts are one graph, so the p2 loop at n1 has +yellow
formula FormulaBlueYellow {
  <+blue +yellow> true
}

// True within Model6: the absence of yellow is irrelevant
formula FormulaBlue {
  <+blue> true
}

// Takes a transition with +blue in its label
action ActionBlue {
  +blue
}

// Takes a transition with +red in its label
action ActionRed {
  +red
}

// Takes a transition with +green in its label
action ActionGreen {
  +green
}

// Design notes, not syntax: an action relative to the previous transition
// (`...prev +red`, `...prev -blue`), and persistent subactions such as
// set(/users/alice.id, "12D3KooW...") versus non-persistent ones such as
// include_sig(/users/alice.id).
